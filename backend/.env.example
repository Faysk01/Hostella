# --- Serveur ---
NODE_ENV=development
PORT=5000
# Adresses autorisées à appeler l'API (site public + espace admin), séparées par des virgules
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Base de données (Docker, port 5435) ---
POSTGRES_USER=hostella
POSTGRES_PASSWORD=change_moi_mot_de_passe_db
POSTGRES_DB=hostella
DATABASE_URL=postgresql://hostella:change_moi_mot_de_passe_db@localhost:5435/hostella?schema=public

# --- Session admin (au moins 32 caractères, aléatoire) ---
JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire_de_64_caracteres_minimum

# --- Cloudinary (photos de la galerie et du site) — facultatif au début ---
CLOUDINARY_CLOUD_NAME=dsfoumaud
CLOUDINARY_API_KEY=364741343382145
CLOUDINARY_API_SECRET=yM8ozE9XcAAhXygzDixYGc-KctA

# --- Mise à jour instantanée du site public après une modification dans l'admin (facultatif) ---
# Ex : https://hostella.vercel.app  (même secret que REVALIDATE_SECRET côté frontend)
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=
